# Project Fifty development/paper environment template
# NEVER put real credentials into this tracked file.

PROJECT_FIFTY_ENV=development
PROJECT_FIFTY_LOG_LEVEL=INFO
PROJECT_FIFTY_STARTING_CASH_GBP=50.00
PROJECT_FIFTY_ACCOUNT_CURRENCY=USD
# Frozen Project Fifty paper inception: GBP 50.00 x 1.35345 = USD 67.6725.
PROJECT_FIFTY_AUTHORIZED_STARTING_CASH=67.6725
PROJECT_FIFTY_MAX_ORDER_NOTIONAL=67.6725
PROJECT_FIFTY_MAX_STALE_SECONDS=60
# Bounded M4 candidates only. SPY is the benchmark and is not trade-authorised here.
PROJECT_FIFTY_PERMITTED_SYMBOLS=AAPL,AMZN,GOOGL,META,MSFT,NVDA,QQQ,TLT,GLD,XLU
PROJECT_FIFTY_KILL_SWITCH=false

# Alpaca PAPER credentials only. Keep values blank in this public template.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER_REQUEST_LOG=state/alpaca-request-ids.jsonl

# Read-only Alpaca stock market data used by M4.
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex

# Reserved for later stages. Keep blank in public/example configuration.
MODEL_API_KEY=
DATABASE_URL=
